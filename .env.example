# Crossfire — copy to .env and fill locally. NEVER commit .env or real values.

# Mode: public (default, marks only) | demo | live
CROSSFIRE_MODE=public
CROSSFIRE_HOST=127.0.0.1
CROSSFIRE_PORT=8770

# Heartbeat (seconds) and event-wake mark move threshold (%)
CROSSFIRE_HEARTBEAT_SEC=300
CROSSFIRE_EVENT_MOVE_PCT=1.5
CROSSFIRE_BOOKS_CACHE_SEC=4

# Policy divergence threshold (Mag7 24h avg vs BTC), percent points
CROSSFIRE_DIV_PCT=2.5

# Agent Risk Cage profile: normal (default) | aggressive
# Live switch also via POST /api/agent/mode without restart
CROSSFIRE_AGENT_MODE=normal

# Risk Cage sleeve notional caps (USDT)
CROSSFIRE_SLEEVE_CAP=2000
CROSSFIRE_LEG_CAP=500

# Bitget public base (optional override)
# BITGET_BASE=https://api.bitget.com

# --- Sleeve (private). Leave empty for PUBLIC MARKS / SLEEVE DISCONNECTED ---
# Prefer Bitget Agentic / Demo keys. Never paste secrets into chat or git.
# BITGET_API_KEY=
# BITGET_SECRET_KEY=
# BITGET_PASSPHRASE=

# --- Optional LLM. If unset, engine uses transparent policy rules (engine: policy) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CROSSFIRE_LLM_MODEL=
